+[[nodiscard]] bool IsLocalBadgeOfStyle(
+		ID peerId,
+		AyuCosmetics::BadgeStyle style) {
+	using Style = AyuCosmetics::BadgeStyle;
+	auto current = AyuCosmetics::LocalBadgeStyle();
+	// The owner badge belongs to one account, others get the supporter one.
+	if (current == Style::Emoji && peerId != AyuCosmetics::kOwnerBadgeId) {
+		current = Style::Supporter;
+	}
+	if (current != style) {
+		return false;
+	} else if (style == Style::Emoji
+		&& !AyuSettings::getInstance().localBadgeEmojiId()) {
+		return false;
+	}
+	return AyuCosmetics::IsLocalBadgePeer(peerId);
+}
