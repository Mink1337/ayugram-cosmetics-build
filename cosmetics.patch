new file mode 100644
--- /dev/null
+++ b/Telegram/SourceFiles/ayu/features/local_cosmetics/local_cosmetics.cpp
@@ -0,0 +1,254 @@
+// This is the source code of AyuGram for Desktop.
+//
+// We do not and cannot prevent the use of our code,
+// but be respectful and credit the original author.
+//
+// Copyright @Radolyn, 2026
+#include "ayu/features/local_cosmetics/local_cosmetics.h"
+
+#include "api/api_premium.h"
+#include "apiwrap.h"
+#include "ayu/ayu_settings.h"
+#include "core/application.h"
+#include "data/data_session.h"
+#include "main/main_account.h"
+#include "main/main_domain.h"
+#include "main/main_session.h"
+
+#include <QtCore/QJsonArray>
+#include <QtCore/QJsonDocument>
+#include <QtCore/QJsonObject>
+
+namespace AyuCosmetics {
+namespace {
+
+constexpr auto kLocalIdBase = uint64(0x7A79000000000000ULL);
+constexpr auto kLocalIdMask = uint64(0xFFFF000000000000ULL);
+
+template <typename Attribute>
+[[nodiscard]] const Attribute *FindByName(
+		const std::vector<Attribute> &list,
+		const QString &name) {
+	for (const auto &attribute : list) {
+		if (attribute.name == name) {
+			return &attribute;
+		}
+	}
+	return nullptr;
+}
+
+} // namespace
+
+bool IsLocalBadgePeer(int64 bareId) {
+	if (!AyuSettings::getInstance().localBadgeEnabled()) {
+		return false;
+	}
+	for (const auto &entry : Core::App().domain().accounts()) {
+		if (entry.account->sessionExists()
+			&& int64(entry.account->session().userId().bare) == bareId) {
+			return true;
+		}
+	}
+	return false;
+}
+
+bool IsLocalGiftId(uint64 id) {
+	return (id & kLocalIdMask) == kLocalIdBase;
+}
+
+std::vector<LocalGift> LoadGifts() {
+	const auto document = QJsonDocument::fromJson(
+		AyuSettings::getInstance().localGifts().toUtf8());
+	auto result = std::vector<LocalGift>();
+	for (const auto &value : document.array()) {
+		const auto object = value.toObject();
+		result.push_back({
+			.giftId = object.value(u"giftId"_q).toString().toULongLong(),
+			.title = object.value(u"title"_q).toString(),
+			.modelName = object.value(u"model"_q).toString(),
+			.backdropName = object.value(u"backdrop"_q).toString(),
+			.patternName = object.value(u"pattern"_q).toString(),
+			.ownerName = object.value(u"owner"_q).toString(),
+			.number = object.value(u"number"_q).toInt(1),
+			.date = TimeId(object.value(u"date"_q).toInt()),
+		});
+	}
+	return result;
+}
+
+void SaveGifts(const std::vector<LocalGift> &gifts) {
+	auto array = QJsonArray();
+	for (const auto &gift : gifts) {
+		auto object = QJsonObject();
+		object.insert(u"giftId"_q, QString::number(gift.giftId));
+		object.insert(u"title"_q, gift.title);
+		object.insert(u"model"_q, gift.modelName);
+		object.insert(u"backdrop"_q, gift.backdropName);
+		object.insert(u"pattern"_q, gift.patternName);
+		object.insert(u"owner"_q, gift.ownerName);
+		object.insert(u"number"_q, gift.number);
+		object.insert(u"date"_q, int(gift.date));
+		array.push_back(object);
+	}
+	AyuSettings::getInstance().setLocalGifts(QString::fromUtf8(
+		QJsonDocument(array).toJson(QJsonDocument::Compact)));
+}
+
+int GiftsCount() {
+	return int(LoadGifts().size());
+}
+
+Data::SavedStarGift BuildSavedGift(
+		const Data::StarGift &base,
+		const Data::UniqueGiftModel &model,
+		const Data::UniqueGiftPattern &pattern,
+		const Data::UniqueGiftBackdrop &backdrop,
+		const LocalGift &gift,
+		int index) {
+	const auto id = kLocalIdBase + uint64(index) + 1;
+	// WHY: no owner id, slug or manage id, so the gift view stays read-only
+	// and never offers transfer, sale or wear actions the server would reject.
+	return Data::SavedStarGift{
+		.info = Data::StarGift{
+			.id = id,
+			.unique = std::make_shared<Data::UniqueGift>(Data::UniqueGift{
+				.id = id,
+				.initialGiftId = gift.giftId,
+				.title = gift.title,
+				.ownerName = gift.ownerName,
+				.number = gift.number,
+				.model = model,
+				.pattern = pattern,
+				.backdrop = backdrop,
+			}),
+			.document = model.document,
+			.limitedLeft = base.limitedLeft,
+			.limitedCount = base.limitedCount,
+		},
+		.date = gift.date,
+	};
+}
+
+void RequestCatalog(
+		not_null<Main::Session*> session,
+		Fn<void(std::vector<Data::StarGift>)> done,
+		Fn<void(QString)> fail) {
+	session->api().request(MTPpayments_GetStarGifts(
+		MTP_int(0)
+	)).done([=](const MTPpayments_StarGifts &result) {
+		auto gifts = std::vector<Data::StarGift>();
+		result.match([&](const MTPDpayments_starGifts &data) {
+			session->data().processUsers(data.vusers());
+			session->data().processChats(data.vchats());
+			for (const auto &gift : data.vgifts().v) {
+				if (auto parsed = Api::FromTL(session, gift)) {
+					gifts.push_back(std::move(*parsed));
+				}
+			}
+		}, [](const MTPDpayments_starGiftsNotModified &) {
+		});
+		done(std::move(gifts));
+	}).fail([=](const MTP::Error &error) {
+		fail(error.type());
+	}).send();
+}
+
+void RequestAttributes(
+		not_null<Main::Session*> session,
+		uint64 giftId,
+		Fn<void(Data::UniqueGiftAttributes)> done,
+		Fn<void(QString)> fail) {
+	session->api().request(MTPpayments_GetStarGiftUpgradeAttributes(
+		MTP_long(giftId)
+	)).done([=](const MTPpayments_StarGiftUpgradeAttributes &result) {
+		auto attributes = Data::UniqueGiftAttributes();
+		for (const auto &attribute : result.data().vattributes().v) {
+			attribute.match([&](const MTPDstarGiftAttributeModel &data) {
+				attributes.models.push_back(Api::FromTL(session, data));
+			}, [&](const MTPDstarGiftAttributePattern &data) {
+				attributes.patterns.push_back(Api::FromTL(session, data));
+			}, [&](const MTPDstarGiftAttributeBackdrop &data) {
+				attributes.backdrops.push_back(Api::FromTL(data));
+			}, [](const auto &) {
+			});
+		}
+		done(std::move(attributes));
+	}).fail([=](const MTP::Error &error) {
+		fail(error.type());
+	}).send();
+}
+
+void ResolveGifts(
+		not_null<Main::Session*> session,
+		Fn<void(std::vector<Data::SavedStarGift>)> done) {
+	const auto gifts = LoadGifts();
+	if (gifts.empty()) {
+		done({});
+		return;
+	}
+	RequestCatalog(session, [=](std::vector<Data::StarGift> catalog) {
+		struct State {
+			std::vector<Data::StarGift> catalog;
+			base::flat_map<uint64, Data::UniqueGiftAttributes> attributes;
+			int pending = 0;
+		};
+		const auto state = std::make_shared<State>();
+		state->catalog = std::move(catalog);
+
+		auto ids = base::flat_set<uint64>();
+		for (const auto &gift : gifts) {
+			ids.emplace(gift.giftId);
+		}
+		state->pending = int(ids.size());
+
+		const auto finish = [=] {
+			if (--state->pending > 0) {
+				return;
+			}
+			auto result = std::vector<Data::SavedStarGift>();
+			for (auto i = 0; i != int(gifts.size()); ++i) {
+				const auto &gift = gifts[i];
+				const auto base = ranges::find(
+					state->catalog,
+					gift.giftId,
+					&Data::StarGift::id);
+				const auto found = state->attributes.find(gift.giftId);
+				if (base == end(state->catalog)
+					|| found == end(state->attributes)) {
+					continue;
+				}
+				const auto &list = found->second;
+				const auto model = FindByName(list.models, gift.modelName);
+				const auto pattern = FindByName(
+					list.patterns,
+					gift.patternName);
+				const auto backdrop = FindByName(
+					list.backdrops,
+					gift.backdropName);
+				if (model && pattern && backdrop) {
+					result.push_back(BuildSavedGift(
+						*base,
+						*model,
+						*pattern,
+						*backdrop,
+						gift,
+						i));
+				}
+			}
+			done(std::move(result));
+		};
+		for (const auto id : ids) {
+			RequestAttributes(session, id, [=](
+					Data::UniqueGiftAttributes attributes) {
+				state->attributes.emplace(id, std::move(attributes));
+				finish();
+			}, [=](const QString &) {
+				finish();
+			});
+		}
+	}, [=](const QString &) {
+		done({});
+	});
+}
+
+} // namespace AyuCosmetics
