+
+using namespace Builder;
+using namespace AyuBuilder;
+
+namespace {
+
+constexpr auto kMaxRatingLevel = 90;
+constexpr auto kMaxLocalStars = int64(1'000'000'000'000);
+
+[[nodiscard]] QString BadgeStyleName(int style) {
+	using Style = ::AyuCosmetics::BadgeStyle;
+	switch (Style(style)) {
+	case Style::Developer: return u"Разработчик AyuNFT"_q;
+	case Style::Emoji: return u"Владелец AyuNFT"_q;
+	case Style::Supporter: break;
+	}
+	return u"Поддержка AyuNFT"_q;
+}
+
+[[nodiscard]] bool IsBadgeOwner(
+		not_null<Window::SessionController*> controller) {
+	return int64(controller->session().userId().bare)
+		== ::AyuCosmetics::kOwnerBadgeId;
+}
+
+void ChooseBadgeStyleBox(
+		not_null<Ui::GenericBox*> box,
+		bool owner) {
+	box->setTitle(tr::ayu_LocalBadgeStyle());
+	const auto current = AyuSettings::getInstance().localBadgeStyle();
+	for (auto style = 0; style != (owner ? 3 : 2); ++style) {
+		const auto button = AddButtonWithLabel(
+			box->verticalLayout(),
+			rpl::single(BadgeStyleName(style)),
+			rpl::single((style == current) ? u"✓"_q : QString()),
+			st::settingsButtonNoIcon);
+		button->setClickedCallback([=] {
+			AyuSettings::getInstance().setLocalBadgeStyle(style);
+			box->closeBox();
+		});
+	}
+	box->addButton(tr::lng_cancel(), [=] {
+		box->closeBox();
+	});
+}
+
+void BuildBadge(SectionBuilder &builder, AyuSectionBuilder &ayu) {
+	const auto controller = builder.controller();
+
+	builder.addSkip();
+	builder.addSubsectionTitle(tr::ayu_LocalBadgeHeader());
+	ayu.addSettingToggle({
+		.id = u"ayu/localBadge"_q,
+		.title = tr::ayu_LocalBadgeEnable(),
+		.getter = &AyuSettings::localBadgeEnabled,
+		.setter = &AyuSettings::setLocalBadgeEnabled,
+		.icon = { &st::menuIconPremium },
+	});
+	builder.addButton({
+		.id = u"ayu/localBadgeStyle"_q,
+		.title = tr::ayu_LocalBadgeStyle(),
+		.icon = { &st::menuIconChangeColors },
+		.label = AyuSettings::getInstance().localBadgeStyleValue(
+		) | rpl::map(BadgeStyleName),
+		.onClick = [=] {
+			controller->show(Box(
+				ChooseBadgeStyleBox,
+				IsBadgeOwner(controller)));
+		},
+	});
+	ayu.addSettingToggle({
+		.id = u"ayu/localPremiumCosmetics"_q,
+		.title = tr::ayu_LocalPremium(),
+		.getter = &AyuSettings::localPremium,
+		.setter = &AyuSettings::setLocalPremium,
+		.icon = { &st::menuIconStar },
+	});
+	builder.add([=](const BuildContext &ctx) {
+		v::match(ctx, [&](const WidgetContext &wctx) {
+			const auto container = wctx.container;
+			const auto panel = container->lifetime().make_state<
+				Info::Profile::EmojiStatusPanel>();
+			panel->setChooseFilter([=](EmojiStatusId id) {
+				auto &settings = AyuSettings::getInstance();
+				settings.setLocalBadgeEmojiId(id.documentId);
+				if (id.documentId && IsBadgeOwner(controller)) {
+					settings.setLocalBadgeStyle(
+						int(::AyuCosmetics::BadgeStyle::Emoji));
+				}
+				panel->hideAnimated();
+				return false;
+			});
+			const auto emoji = AddButtonWithIcon(
+				container,
+				tr::ayu_LocalBadgeEmoji(),
+				st::settingsButton,
+				{ &st::menuIconPalette });
+			emoji->setClickedCallback([=] {
+				panel->show(Info::Profile::EmojiStatusPanel::Descriptor{
+					.controller = controller,
+					.button = emoji,
+				});
+			});
+			AddButtonWithLabel(
+				container,
+				tr::ayu_LocalBadgeText(),
+				AyuSettings::getInstance().localBadgeTextValue(),
+				st::settingsButton,
+				{ &st::menuIconChatBubble }
+			)->setClickedCallback([=] {
+				controller->show(Box<EditMarkBox>(
+					tr::ayu_LocalBadgeText(),
+					AyuSettings::getInstance().localBadgeText(),
+					QString(),
+					[](const QString &value) {
+						AyuSettings::getInstance().setLocalBadgeText(value);
+					}));
+			});
+		}, [&](const SearchContext &sctx) {
+			sctx.entries->push_back({
+				.id = u"ayu/localBadgeEmoji"_q,
+				.title = tr::ayu_LocalBadgeEmoji(tr::now),
+				.section = sctx.sectionId,
+			});
+		});
+	});
+	builder.addSkip();
+	builder.addDividerText(tr::ayu_LocalCosmeticsDescription());
+}
+
+void BuildProfile(SectionBuilder &builder, AyuSectionBuilder &ayu) {
+	const auto controller = builder.controller();
+
+	builder.addSkip();
+	builder.addSubsectionTitle(tr::ayu_LocalProfileHeader());
+	ayu.addSettingToggle({
+		.id = u"ayu/localVerified"_q,
+		.title = tr::ayu_LocalVerified(),
+		.getter = &AyuSettings::localVerified,
+		.setter = &AyuSettings::setLocalVerified,
+		.icon = { &st::menuIconFave },
+	});
+	builder.addButton({
+		.id = u"ayu/localLevel"_q,
+		.title = tr::ayu_LocalLevel(),
+		.icon = { &st::menuIconShowAll },
+		.label = AyuSettings::getInstance().localRatingLevelValue(
+		) | rpl::map([](int level) {
+			return level ? QString::number(level) : QString();
+		}),
+		.onClick = [=] {
+			controller->show(Box<EditMarkBox>(
+				tr::ayu_LocalLevel(),
+				QString::number(
+					AyuSettings::getInstance().localRatingLevel()),
+				u"0"_q,
+				[=](const QString &value) {
+					AyuSettings::getInstance().setLocalRatingLevel(std::clamp(
+						value.trimmed().toInt(),
+						0,
+						kMaxRatingLevel));
+					const auto session = &controller->session();
+					session->changes().peerUpdated(
+						session->user(),
+						Data::PeerUpdate::Flag::StarsRating);
+				}));
+		},
+	});
+	builder.addSkip();
+}
+
+void BuildGifts(SectionBuilder &builder) {
+	const auto controller = builder.controller();
+
+	builder.addDivider();
+	builder.addSkip();
+	builder.addSubsectionTitle(tr::ayu_LocalNftHeader());
+	builder.addButton({
+		.id = u"ayu/localNftCreate"_q,
+		.title = tr::ayu_LocalNftConstructor(),
+		.icon = { &st::menuIconPalette },
+		.onClick = [=] {
+			controller->show(Box(
+				::AyuCosmetics::LocalNftConstructorBox,
+				controller,
+				-1,
+				(PeerData*)nullptr));
+		},
+	});
+	builder.addButton({
+		.id = u"ayu/localNftList"_q,
+		.title = tr::ayu_LocalNftList(),
+		.icon = { &st::menuIconTagFilter },
+		.onClick = [=] {
+			if (!::AyuCosmetics::GiftsCount()) {
+				controller->showToast(tr::ayu_LocalNftEmpty(tr::now));
+				return;
+			}
+			controller->show(Box(
+				::AyuCosmetics::LocalNftListBox,
+				controller));
+		},
+	});
+	builder.addSkip();
+}
+
+void BuildBalance(SectionBuilder &builder) {
+	const auto controller = builder.controller();
+
+	builder.addDivider();
+	builder.addSkip();
+	builder.addSubsectionTitle(tr::ayu_LocalBalanceHeader());
+	builder.addButton({
+		.id = u"ayu/localStars"_q,
+		.title = tr::ayu_LocalStars(),
+		.icon = { &st::menuIconStar },
+		.label = AyuSettings::getInstance().localStarsValue(
+		) | rpl::map([](int64 value) {
+			return value ? QString::number(value) : QString();
+		}),
+		.onClick = [=] {
+			controller->show(Box<EditMarkBox>(
+				tr::ayu_LocalStars(),
+				QString::number(AyuSettings::getInstance().localStars()),
+				u"0"_q,
+				[](const QString &value) {
+					AyuSettings::getInstance().setLocalStars(std::clamp(
+						value.trimmed().toLongLong(),
+						int64(0),
+						kMaxLocalStars));
+					::AyuCosmetics::RefreshBalances();
+				}));
+		},
+	});
+	builder.addButton({
+		.id = u"ayu/localTon"_q,
+		.title = tr::ayu_LocalTon(),
+		.icon = { &st::menuIconEarn },
+		.label = AyuSettings::getInstance().localTonValue(
+		) | rpl::map([](const QString &value) {
+			return ::AyuCosmetics::FormatNanoTon(
+				::AyuCosmetics::ParseNanoTon(value));
+		}),
+		.onClick = [=] {
+			controller->show(Box<EditMarkBox>(
+				tr::ayu_LocalTon(),
+				AyuSettings::getInstance().localTon(),
+				u"0"_q,
+				[](const QString &value) {
+					AyuSettings::getInstance().setLocalTon(
+						::AyuCosmetics::FormatNanoTon(
+							::AyuCosmetics::ParseNanoTon(value)));
+					::AyuCosmetics::RefreshBalances();
+				}));
+		},
+	});
+	builder.addSkip();
+	builder.addDividerText(tr::ayu_LocalBalanceDescription());
+}
+
+void BuildUsernames(SectionBuilder &builder) {
+	const auto controller = builder.controller();
+
+	builder.addSkip();
+	builder.addSubsectionTitle(tr::ayu_LocalUsernames());
+	builder.addButton({
+		.id = u"ayu/localUsernames"_q,
+		.title = tr::ayu_LocalUsernamesManage(),
+		.icon = { &st::menuIconUsername },
+		.label = AyuSettings::getInstance().localUsernamesValue(
+		) | rpl::map([](const QString &) {
+			const auto count = int(::AyuCosmetics::LoadUsernames().size());
+			return count ? QString::number(count) : QString();
+		}),
+		.onClick = [=] {
+			controller->show(Box(
+				::AyuCosmetics::LocalUsernamesBox,
+				controller));
+		},
+	});
+	builder.addSkip();
+	builder.addDividerText(tr::ayu_LocalUsernamesDescription());
+}
+
+const auto kMeta = BuildHelper({
+	.id = AyuCosmetics::Id(),
+	.parentId = AyuMain::Id(),
+	.title = &tr::ayu_LocalCosmetics,
+	.icon = &st::menuIconPremium,
+}, [](SectionBuilder &builder) {
+	auto ayu = AyuSectionBuilder(builder);
+
+	BuildBadge(builder, ayu);
+	BuildProfile(builder, ayu);
+	BuildGifts(builder);
+	BuildBalance(builder);
+	BuildUsernames(builder);
+});
+
+} // namespace
+
+rpl::producer<QString> AyuCosmetics::title() {
+	return tr::ayu_LocalCosmetics();
+}
+
+AyuCosmetics::AyuCosmetics(
+	QWidget *parent,
+	not_null<Window::SessionController*> controller)
+: Section(parent, controller) {
+	setupContent();
+}
+
+void AyuCosmetics::setupContent() {
+	const auto content = Ui::CreateChild<Ui::VerticalLayout>(this);
+	build(content, kMeta.build);
+	Ui::ResizeFitChild(this, content);
+}
+
+} // namespace Settings
