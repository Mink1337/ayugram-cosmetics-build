+[[nodiscard]] int FindIndex(
+		const std::vector<Attribute> &list,
+		const QString &name) {
+	for (auto i = 0; i != int(list.size()); ++i) {
+		if (list[i].name == name) {
+			return i;
+		}
+	}
+	return list.empty() ? -1 : 0;
+}
