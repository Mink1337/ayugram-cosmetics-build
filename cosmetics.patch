+
+void LocalNftConstructorBox(
+		not_null<Ui::GenericBox*> box,
+		not_null<Window::SessionController*> controller,
+		int editIndex,
+		PeerData *) {
+	const auto session = &controller->session();
+	const auto state = box->lifetime().make_state<ConstructorState>();
+	const auto container = box->verticalLayout();
+	{
+		const auto gifts = LoadGifts();
+		if (editIndex >= 0 && editIndex < int(gifts.size())) {
+			state->initial = gifts[editIndex];
+		} else {
+			editIndex = -1;
+		}
+	}
+	const auto initial = state->initial;
+
+	box->setWidth(st::boxWideWidth);
+	box->setTitle(editIndex >= 0
+		? tr::ayu_LocalNftEdit()
+		: tr::ayu_LocalNftConstructor());
+
+	// The cover is added here once the first gift and attributes arrive.
+	const auto coverWrap = container->add(
+		object_ptr<Ui::VerticalLayout>(container));
+
+	const auto loading = tr::ayu_LocalNftLoading(tr::now);
+	state->giftLabel = loading;
+
+	Ui::AddSkip(container);
+	const auto addRow = [=](
+			rpl::producer<QString> title,
+			rpl::producer<QString> value,
+			const style::icon *icon) {
+		return Settings::AddButtonWithLabel(
+			container,
+			std::move(title),
+			std::move(value),
+			st::settingsButton,
+			{ icon });
+	};
+	const auto giftButton = addRow(
+		tr::ayu_LocalNftGift(),
+		state->giftLabel.value(),
+		&st::menuIconGiftPremium);
+	const auto modelButton = addRow(
+		tr::ayu_LocalNftModel(),
+		state->modelLabel.value(),
+		&st::menuIconNftWear);
+	const auto backdropButton = addRow(
+		tr::ayu_LocalNftBackdrop(),
+		state->backdropLabel.value(),
+		&st::menuIconPalette);
+	const auto patternButton = addRow(
+		tr::ayu_LocalNftPattern(),
+		state->patternLabel.value(),
+		&st::menuIconChangeColors);
+	Ui::AddSkip(container);
+
+	const auto number = AddField(
+		box,
+		tr::ayu_LocalNftNumber(),
+		QString::number(initial ? initial->number : 1));
+	const auto stars = AddField(
+		box,
+		tr::ayu_LocalNftPriceStars(),
+		(initial && initial->resaleStars > 0)
+			? QString::number(initial->resaleStars)
+			: QString());
+	const auto ton = AddField(
+		box,
+		tr::ayu_LocalNftPriceTon(),
+		initial ? FormatNanoTon(initial->resaleNanoTon) : QString());
+	const auto countText = [](int value) {
+		return value ? QString::number(value) : QString();
+	};
+	const auto issued = AddField(
+		box,
+		rpl::single(u"Выпущено (пусто — как в оригинале)"_q),
+		initial ? countText(initial->issued) : QString());
+	const auto total = AddField(
+		box,
+		rpl::single(u"Всего (пусто — как в оригинале)"_q),
+		initial ? countText(initial->total) : QString());
+	const auto value = AddField(
+		box,
+		rpl::single(u"Стоимость в долларах"_q),
+		(initial && initial->valueCents > 0)
+			? QString::number(initial->valueCents / 100.)
+			: QString());
+	const auto ownerName = AddField(
+		box,
+		rpl::single(u"Имя владельца (необязательно)"_q),
+		initial ? initial->ownerName : QString());
+	const auto ownerUrl = AddField(
+		box,
+		rpl::single(u"Ссылка владельца: t.me/… или Fragment"_q),
+		initial ? initial->ownerUrl : QString());
+	Ui::AddSkip(container);
+
+	const auto updateNumber = [=] {
+		state->numberText = u"#"_q + QString::number(
+			ParseNumber(number->getLastText()));
+	};
+	const auto updateResale = [=] {
+		state->resale = ResaleAmount(
+			ParseStars(stars->getLastText()),
+			ParseNanoTon(ton->getLastText()));
+	};
+	updateNumber();
+	updateResale();
+
+	const auto ready = [=] {
+		const auto &list = state->attributes;
+		return (state->gift >= 0)
+			&& (state->model >= 0 && state->model < int(list.models.size()))
+			&& (state->backdrop >= 0
+				&& state->backdrop < int(list.backdrops.size()))
+			&& (state->pattern >= 0
+				&& state->pattern < int(list.patterns.size()));
+	};
+	const auto currentUnique = [=] {
+		const auto &list = state->attributes;
+		return Data::UniqueGift{
+			.title = state->title,
+			.number = ParseNumber(number->getLastText()),
+			.model = list.models[state->model],
+			.pattern = list.patterns[state->pattern],
+			.backdrop = list.backdrops[state->backdrop],
+		};
+	};
+	const auto refreshCover = [=] {
+		if (!ready()) {
+			return;
+		}
+		const auto &list = state->attributes;
+		state->modelLabel = list.models[state->model].name;
+		state->backdropLabel = list.backdrops[state->backdrop].name;
+		state->patternLabel = list.patterns[state->pattern].name;
+		auto cover = Ui::UniqueGiftCover{
+			.values = currentUnique(),
+			.force = true,
+		};
+		if (state->cover) {
+			*state->cover = std::move(cover);
+			return;
+		}
+		state->cover = std::make_unique<rpl::variable<Ui::UniqueGiftCover>>(
+			std::move(cover));
+		Ui::AddUniqueGiftCover(coverWrap, state->cover->value(), {
+			.numberText = state->numberText.value(),
+			.resalePrice = state->resale.value(),
+		});
+		coverWrap->resizeToWidth(container->width());
+	};
+
+	number->changes() | rpl::on_next([=] {
+		updateNumber();
+		refreshCover();
+	}, number->lifetime());
+	stars->changes() | rpl::on_next(updateResale, stars->lifetime());
+	ton->changes() | rpl::on_next(updateResale, ton->lifetime());
+
+	const auto selectGift = [=](int index, bool applyInitial) {
+		const auto &gift = state->catalog[index];
+		state->gift = index;
+		state->model = state->backdrop = state->pattern = -1;
+		state->attributes = {};
+		state->giftLabel = GiftTitle(gift);
+		state->modelLabel = loading;
+		state->backdropLabel = loading;
+		state->patternLabel = loading;
+		state->title = GiftTitle(gift);
+		RequestAttributes(session, gift.id, crl::guard(box, [=](
+				Data::UniqueGiftAttributes attributes) {
+			if (state->gift != index) {
+				return;
+			}
+			state->attributes = std::move(attributes);
+			const auto &list = state->attributes;
+			if (list.models.empty()
+				|| list.backdrops.empty()
+				|| list.patterns.empty()) {
+				state->modelLabel = QString();
+				state->backdropLabel = QString();
+				state->patternLabel = QString();
+				controller->showToast(tr::ayu_LocalNftNoAttributes(tr::now));
+				return;
+			}
+			const auto use = applyInitial
+				? initial
+				: std::optional<LocalGift>();
+			state->model = use ? FindIndex(list.models, use->modelName) : 0;
+			state->backdrop = use
+				? FindIndex(list.backdrops, use->backdropName)
+				: 0;
+			state->pattern = use
+				? FindIndex(list.patterns, use->patternName)
+				: 0;
+			refreshCover();
+		}), crl::guard(box, [=](const QString &error) {
+			controller->showToast(error);
+		}));
+	};
+
+	RequestCatalog(session, crl::guard(box, [=](
+			std::vector<Data::StarGift> catalog) {
+		catalog.erase(ranges::remove_if(catalog, [](
+				const Data::StarGift &gift) {
+			return !gift.upgradable && !gift.upgradeVariants;
+		}), end(catalog));
+		state->catalog = std::move(catalog);
+		if (state->catalog.empty()) {
+			state->giftLabel = QString();
+			controller->showToast(tr::ayu_LocalNftNoAttributes(tr::now));
+			return;
+		}
+		auto index = 0;
+		if (initial) {
+			const auto i = ranges::find(
+				state->catalog,
+				initial->giftId,
+				&Data::StarGift::id);
+			if (i != end(state->catalog)) {
+				index = int(i - begin(state->catalog));
+			}
+		}
+		selectGift(index, initial.has_value());
+	}), crl::guard(box, [=](const QString &error) {
+		controller->showToast(error);
+	}));
+
+	giftButton->setClickedCallback([=] {
+		if (state->catalog.empty()) {
+			return;
+		}
+		controller->show(Box(
+			GiftPickerBox,
+			controller,
+			state->catalog,
+			state->gift,
+			crl::guard(box, [=](int index) {
+				selectGift(index, false);
+			})));
+	});
+	const auto openAppearance = [=](Data::GiftAttributeIdType tab) {
+		if (!ready()) {
+			return;
+		}
+		const auto selected = std::make_shared<Data::UniqueGift>(
+			currentUnique());
+		controller->show(Box(
+			Ui::StarGiftAttributesChooseBox,
+			state->title,
+			state->attributes,
+			tab,
+			selected,
+			crl::guard(box, [=](const Data::UniqueGift &chosen) {
+				const auto &list = state->attributes;
+				const auto model = FindIndexById(list.models, chosen.model);
+				const auto backdrop = FindIndexById(
+					list.backdrops,
+					chosen.backdrop);
+				const auto pattern = FindIndexById(
+					list.patterns,
+					chosen.pattern);
+				if (model >= 0) {
+					state->model = model;
+				}
+				if (backdrop >= 0) {
+					state->backdrop = backdrop;
+				}
+				if (pattern >= 0) {
+					state->pattern = pattern;
+				}
+				refreshCover();
+			})));
+	};
+	modelButton->setClickedCallback([=] {
+		openAppearance(Data::GiftAttributeIdType::Model);
+	});
+	backdropButton->setClickedCallback([=] {
+		openAppearance(Data::GiftAttributeIdType::Backdrop);
+	});
+	patternButton->setClickedCallback([=] {
+		openAppearance(Data::GiftAttributeIdType::Pattern);
+	});
+
+	const auto current = [=] {
+		const auto &list = state->attributes;
+		const auto starsPrice = ParseStars(stars->getLastText());
+		return LocalGift{
+			.giftId = state->catalog[state->gift].id,
+			.title = state->title,
+			.modelName = list.models[state->model].name,
+			.backdropName = list.backdrops[state->backdrop].name,
+			.patternName = list.patterns[state->pattern].name,
+			.peerId = initial ? initial->peerId : 0,
+			.number = ParseNumber(number->getLastText()),
+			.date = initial ? initial->date : base::unixtime::now(),
+			.resaleStars = starsPrice,
+			.resaleNanoTon = starsPrice
+				? int64(0)
+				: ParseNanoTon(ton->getLastText()),
+			.issued = ParseCount(issued->getLastText()),
+			.total = ParseCount(total->getLastText()),
+			.valueCents = ParseCents(value->getLastText()),
+			.ownerName = ownerName->getLastText().trimmed(),
+			.ownerUrl = NormalizeOwnerUrl(ownerUrl->getLastText()),
+		};
+	};
+	box->addButton(tr::lng_settings_save(), [=] {
+		if (!ready()) {
+			controller->showToast(tr::ayu_LocalNftSelectAll(tr::now));
+			return;
+		}
+		auto gifts = LoadGifts();
+		const auto gift = current();
+		if (editIndex >= 0 && editIndex < int(gifts.size())) {
+			const auto was = GiftOwnerId(session, gifts[editIndex]);
+			gifts[editIndex] = gift;
+			SaveGifts(gifts);
+			NotifyGiftsChanged(controller, was);
+			controller->showToast(tr::ayu_LocalNftUpdated(tr::now));
+		} else {
+			gifts.push_back(gift);
+			SaveGifts(gifts);
+			controller->showToast(tr::ayu_LocalNftSaved(tr::now));
+		}
+		NotifyGiftsChanged(controller, GiftOwnerId(session, gift));
+		box->closeBox();
+	});
+	box->addButton(tr::lng_cancel(), [=] {
+		box->closeBox();
+	});
+}
+
+void LocalNftListBox(
+		not_null<Ui::GenericBox*> box,
+		not_null<Window::SessionController*> controller) {
+	const auto session = &controller->session();
+	box->setTitle(tr::ayu_LocalNftList());
+	const auto gifts = LoadGifts();
+	for (auto i = 0; i != int(gifts.size()); ++i) {
+		const auto &gift = gifts[i];
+		const auto owner = GiftOwnerId(session, gift);
+		const auto label = (owner == session->userPeerId())
+			? QString()
+			: session->data().peer(owner)->name();
+		const auto button = Settings::AddButtonWithLabel(
+			box->verticalLayout(),
+			rpl::single(gift.title
+				+ u" #"_q
+				+ QString::number(gift.number)),
+			rpl::single(label),
+			st::settingsButtonNoIcon);
+		button->setClickedCallback([=] {
+			box->closeBox();
+			controller->show(Box(
+				LocalNftConstructorBox,
+				controller,
+				i,
+				(PeerData*)nullptr));
+		});
+	}
+	box->addButton(tr::lng_close(), [=] {
+		box->closeBox();
+	});
+}
+
+void FillLocalGiftMenu(
+		not_null<Ui::PopupMenu*> menu,
+		not_null<Window::SessionController*> controller,
+		int index) {
+	menu->addAction(u"Передать"_q, [=] {
+		ChooseRecipient(controller, [=](not_null<PeerData*> peer) {
+			auto gifts = LoadGifts();
+			if (index < 0 || index >= int(gifts.size())) {
+				return;
+			}
+			const auto session = &controller->session();
+			const auto was = GiftOwnerId(session, gifts[index]);
+			gifts[index].peerId = peer->isSelf() ? 0 : peer->id.value;
+			SaveGifts(gifts);
+			NotifyGiftsChanged(controller, was);
+			NotifyGiftsChanged(controller, peer->id);
+			controller->showToast(u"Подарок передан."_q);
+		});
+	}, &st::menuIconReplace);
+	menu->addAction(u"Продать"_q, [=] {
+		controller->show(Box(SellGiftBox, controller, index));
+	}, &st::menuIconTagSell);
+	menu->addAction(tr::ayu_LocalNftEdit(tr::now), [=] {
+		controller->show(Box(
+			LocalNftConstructorBox,
+			controller,
+			index,
+			(PeerData*)nullptr));
+	}, &st::menuIconEdit);
+	menu->addAction(tr::ayu_LocalNftDelete(tr::now), [=] {
+		controller->show(Ui::MakeConfirmBox({
+			.text = tr::ayu_LocalNftDeleteConfirm(tr::rich),
+			.confirmed = [=](Fn<void()> &&close) {
+				auto gifts = LoadGifts();
+				if (index >= 0 && index < int(gifts.size())) {
+					const auto owner = GiftOwnerId(
+						&controller->session(),
+						gifts[index]);
+					gifts.erase(begin(gifts) + index);
+					SaveGifts(gifts);
+					NotifyGiftsChanged(controller, owner);
+				}
+				close();
+			},
+			.confirmText = tr::ayu_LocalNftDelete(),
+		}));
+	}, &st::menuIconDelete);
+}
+
+void LocalUsernamesBox(
+		not_null<Ui::GenericBox*> box,
+		not_null<Window::SessionController*> controller) {
+	box->setTitle(tr::ayu_LocalUsernames());
+	box->setWidth(st::boxWideWidth);
+
+	const auto list = LoadUsernames();
+	for (auto i = 0; i != int(list.size()); ++i) {
+		const auto &entry = list[i];
+		const auto price = FormatNanoTon(entry.nanoTon);
+		const auto button = Settings::AddButtonWithLabel(
+			box->verticalLayout(),
+			rpl::single(u"@"_q + entry.username),
+			rpl::single(price.isEmpty() ? QString() : (price + u" TON"_q)),
+			st::settingsButtonNoIcon);
+		button->setClickedCallback([=] {
+			controller->show(Ui::MakeConfirmBox({
+				.text = tr::ayu_LocalUsernameDeleteConfirm(tr::rich),
+				.confirmed = [=](Fn<void()> &&close) {
+					auto now = LoadUsernames();
+					if (i < int(now.size())) {
+						now.erase(begin(now) + i);
+						SaveUsernames(now);
+					}
+					close();
+					box->closeBox();
+				},
+				.confirmText = tr::ayu_LocalNftDelete(),
+			}));
+		});
+	}
+	if (!list.empty()) {
+		Ui::AddSkip(box->verticalLayout());
+	}
+
+	const auto username = AddField(box, tr::ayu_LocalUsername(), QString());
+	const auto tonPrice = AddField(
+		box,
+		tr::ayu_LocalUsernamePriceTon(),
+		QString());
+	const auto usdPrice = AddField(
+		box,
+		tr::ayu_LocalUsernamePriceUsd(),
+		QString());
+	const auto date = AddField(
+		box,
+		tr::ayu_LocalUsernameDate(),
+		QDate::currentDate().toString(QString::fromLatin1(kDateFormat)));
+	const auto ownerName = AddField(
+		box,
+		rpl::single(u"Имя владельца (необязательно)"_q),
+		QString());
+	const auto ownerUrl = AddField(
+		box,
+		rpl::single(u"Ссылка владельца: t.me/… или Fragment"_q),
+		QString());
+
+	box->addButton(tr::ayu_LocalUsernameAdd(), [=] {
+		auto name = username->getLastText().trimmed();
+		if (name.startsWith('@')) {
+			name = name.mid(1);
+		}
+		static const auto kValid = QRegularExpression(
+			u"^[A-Za-z][A-Za-z0-9_]{3,31}$"_q);
+		if (!kValid.match(name).hasMatch()) {
+			username->showError();
+			controller->showToast(tr::ayu_LocalUsernameInvalid(tr::now));
+			return;
+		}
+		const auto parsedDate = QDate::fromString(
+			date->getLastText().trimmed(),
+			QString::fromLatin1(kDateFormat));
+		const auto when = parsedDate.isValid()
+			? QDateTime(parsedDate, QTime(12, 0)).toSecsSinceEpoch()
+			: QDateTime::currentSecsSinceEpoch();
+		auto usdText = usdPrice->getLastText().trimmed();
+		usdText.replace(',', '.');
+		const auto usd = std::max(usdText.toDouble(), 0.);
+
+		auto now = LoadUsernames();
+		now.erase(ranges::remove_if(now, [&](const LocalUsername &entry) {
+			return !entry.username.compare(name, Qt::CaseInsensitive);
+		}), end(now));
+		now.push_back({
+			.username = name,
+			.nanoTon = ParseNanoTon(tonPrice->getLastText()),
+			.usdCents = int64(std::llround(usd * 100.)),
+			.date = TimeId(when),
+			.ownerName = ownerName->getLastText().trimmed(),
+			.ownerUrl = NormalizeOwnerUrl(ownerUrl->getLastText()),
+		});
+		SaveUsernames(now);
+		controller->showToast(tr::ayu_LocalUsernameAdded(tr::now));
+		box->closeBox();
+	});
+	box->addButton(tr::lng_close(), [=] {
+		box->closeBox();
+	});
+}
+
+} // namespace AyuCosmetics
