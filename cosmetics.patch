new file mode 100644
--- /dev/null
+++ b/Telegram/SourceFiles/ayu/features/local_cosmetics/local_cosmetics.cpp
@@ -0,0 +1,555 @@
+// This is the source code of AyuGram for Desktop.
+//
+// We do not and cannot prevent the use of our code,
+// but be respectful and credit the original author.
+//
+// Copyright @Radolyn, 2026
+#include "ayu/features/local_cosmetics/local_cosmetics.h"
+
+#include "api/api_premium.h"
+#include "apiwrap.h"
+#include "ayu/ayu_settings.h"
+#include "core/application.h"
+#include "data/components/credits.h"
+#include "data/data_peer.h"
+#include "data/data_session.h"
+#include "main/main_account.h"
+#include "main/main_domain.h"
+#include "main/main_session.h"
+
+#include <QtCore/QJsonArray>
+#include <QtCore/QJsonDocument>
+#include <QtCore/QJsonObject>
+
+namespace AyuCosmetics {
+namespace {
+
+constexpr auto kLocalIdBase = uint64(0x7A79000000000000ULL);
+constexpr auto kLocalIdMask = uint64(0xFFFF000000000000ULL);
+constexpr auto kNanosInOne = int64(1'000'000'000);
+constexpr auto kNanoDigits = 9;
+
+struct CatalogRequest {
+	Fn<void(std::vector<Data::StarGift>)> done;
+	Fn<void(QString)> fail;
+};
+
+struct AttributesRequest {
+	Fn<void(Data::UniqueGiftAttributes)> done;
+	Fn<void(QString)> fail;
+};
+
+struct SessionCache {
+	std::optional<std::vector<Data::StarGift>> catalog;
+	std::vector<CatalogRequest> catalogWaiters;
+	base::flat_map<uint64, Data::UniqueGiftAttributes> attributes;
+	base::flat_map<uint64, std::vector<AttributesRequest>> attributeWaiters;
+};
+
+base::flat_map<not_null<Main::Session*>, std::unique_ptr<SessionCache>> Caches;
+
+[[nodiscard]] SessionCache &CacheFor(not_null<Main::Session*> session) {
+	const auto i = Caches.find(session);
+	if (i != end(Caches)) {
+		return *i->second;
+	}
+	session->lifetime().add([=] {
+		Caches.remove(session);
+	});
+	return *Caches.emplace(
+		session,
+		std::make_unique<SessionCache>()).first->second;
+}
+
+template <typename Attribute>
+[[nodiscard]] const Attribute *FindByName(
+		const std::vector<Attribute> &list,
+		const QString &name) {
+	for (const auto &attribute : list) {
+		if (attribute.name == name) {
+			return &attribute;
+		}
+	}
+	return nullptr;
+}
+
+[[nodiscard]] bool BelongsTo(
+		const LocalGift &gift,
+		not_null<const PeerData*> peer) {
+	return gift.peerId
+		? (PeerId(gift.peerId) == peer->id)
+		: peer->isSelf();
+}
+
+[[nodiscard]] QJsonArray ReadArray(const QString &json) {
+	return QJsonDocument::fromJson(json.toUtf8()).array();
+}
+
+[[nodiscard]] QString WriteArray(const QJsonArray &array) {
+	return QString::fromUtf8(
+		QJsonDocument(array).toJson(QJsonDocument::Compact));
+}
+
+[[nodiscard]] int64 ReadInt64(const QJsonObject &object, const QString &key) {
+	return object.value(key).toString().toLongLong();
+}
+
+} // namespace
+
+BadgeStyle LocalBadgeStyle() {
+	const auto value = AyuSettings::getInstance().localBadgeStyle();
+	return (value == int(BadgeStyle::Developer))
+		? BadgeStyle::Developer
+		: (value == int(BadgeStyle::Emoji))
+		? BadgeStyle::Emoji
+		: BadgeStyle::Supporter;
+}
+
+bool IsLocalBadgePeer(int64 bareId) {
+	if (!AyuSettings::getInstance().localBadgeEnabled()) {
+		return false;
+	}
+	for (const auto &entry : Core::App().domain().accounts()) {
+		if (entry.account->sessionExists()
+			&& int64(entry.account->session().userId().bare) == bareId) {
+			return true;
+		}
+	}
+	return false;
+}
+
+bool IsLocalGiftId(uint64 id) {
+	return (id & kLocalIdMask) == kLocalIdBase;
+}
+
+int LocalGiftIndex(uint64 id) {
+	return IsLocalGiftId(id) ? int(id - kLocalIdBase - 1) : -1;
+}
+
+std::vector<LocalGift> LoadGifts() {
+	auto result = std::vector<LocalGift>();
+	for (const auto &value : ReadArray(
+			AyuSettings::getInstance().localGifts())) {
+		const auto object = value.toObject();
+		result.push_back({
+			.giftId = object.value(u"giftId"_q).toString().toULongLong(),
+			.title = object.value(u"title"_q).toString(),
+			.modelName = object.value(u"model"_q).toString(),
+			.backdropName = object.value(u"backdrop"_q).toString(),
+			.patternName = object.value(u"pattern"_q).toString(),
+			.peerId = object.value(u"peer"_q).toString().toULongLong(),
+			.number = object.value(u"number"_q).toInt(1),
+			.date = TimeId(object.value(u"date"_q).toInt()),
+			.resaleStars = ReadInt64(object, u"stars"_q),
+			.resaleNanoTon = ReadInt64(object, u"ton"_q),
+			.issued = object.value(u"issued"_q).toInt(),
+			.total = object.value(u"total"_q).toInt(),
+			.valueCents = ReadInt64(object, u"value"_q),
+			.ownerName = object.value(u"ownerName"_q).toString(),
+			.ownerUrl = object.value(u"ownerUrl"_q).toString(),
+		});
+	}
+	return result;
+}
+
+void SaveGifts(const std::vector<LocalGift> &gifts) {
+	auto array = QJsonArray();
+	for (const auto &gift : gifts) {
+		auto object = QJsonObject();
+		object.insert(u"giftId"_q, QString::number(gift.giftId));
+		object.insert(u"title"_q, gift.title);
+		object.insert(u"model"_q, gift.modelName);
+		object.insert(u"backdrop"_q, gift.backdropName);
+		object.insert(u"pattern"_q, gift.patternName);
+		object.insert(u"peer"_q, QString::number(gift.peerId));
+		object.insert(u"number"_q, gift.number);
+		object.insert(u"date"_q, int(gift.date));
+		object.insert(u"stars"_q, QString::number(gift.resaleStars));
+		object.insert(u"ton"_q, QString::number(gift.resaleNanoTon));
+		object.insert(u"issued"_q, gift.issued);
+		object.insert(u"total"_q, gift.total);
+		object.insert(u"value"_q, QString::number(gift.valueCents));
+		object.insert(u"ownerName"_q, gift.ownerName);
+		object.insert(u"ownerUrl"_q, gift.ownerUrl);
+		array.push_back(object);
+	}
+	AyuSettings::getInstance().setLocalGifts(WriteArray(array));
+}
+
+int GiftsCount() {
+	return int(LoadGifts().size());
+}
+
+int GiftsCountFor(not_null<const PeerData*> peer) {
+	if (AyuSettings::getInstance().localGifts().isEmpty()) {
+		return 0;
+	}
+	return int(ranges::count_if(LoadGifts(), [&](const LocalGift &gift) {
+		return BelongsTo(gift, peer);
+	}));
+}
+
+PeerId GiftOwnerId(
+		not_null<Main::Session*> session,
+		const LocalGift &gift) {
+	return gift.peerId ? PeerId(gift.peerId) : session->userPeerId();
+}
+
+Data::SavedStarGift BuildSavedGift(
+		not_null<Main::Session*> session,
+		const Data::StarGift &base,
+		const Data::UniqueGiftModel &model,
+		const Data::UniqueGiftPattern &pattern,
+		const Data::UniqueGiftBackdrop &backdrop,
+		const LocalGift &gift,
+		int index) {
+	const auto id = kLocalIdBase + uint64(index) + 1;
+	const auto tonOnly = (gift.resaleNanoTon > 0) && (gift.resaleStars <= 0);
+	const auto total = (gift.total > 0)
+		? gift.total
+		: std::max(base.limitedCount, gift.number);
+	const auto issued = std::clamp(
+		(gift.issued > 0)
+			? gift.issued
+			: std::max(base.limitedCount - base.limitedLeft, gift.number),
+		0,
+		total);
+	auto value = std::shared_ptr<Data::UniqueGiftValue>();
+	if (gift.valueCents > 0) {
+		value = std::make_shared<Data::UniqueGiftValue>();
+		value->currency = u"USD"_q;
+		value->valuePrice = gift.valueCents;
+		value->initialPriceStars = CreditsAmount(std::max(base.stars, int64(1)));
+		value->initialSalePrice = gift.valueCents;
+		value->initialSaleDate = gift.date;
+	}
+	// WHY: the gift view treats a gift as buyable only when it is listed and
+	// owned by someone else; sale, wear and transfer need a manage id, which
+	// a local gift never has, so with the owner set the view stays read-only.
+	return Data::SavedStarGift{
+		.info = Data::StarGift{
+			.id = id,
+			.unique = std::make_shared<Data::UniqueGift>(Data::UniqueGift{
+				.id = id,
+				.initialGiftId = gift.giftId,
+				.title = gift.title,
+				.ownerAddress = gift.ownerUrl,
+				.ownerName = gift.ownerName,
+				.ownerId = GiftOwnerId(session, gift),
+				.nanoTonForResale = std::max(gift.resaleNanoTon, int64(0)),
+				.starsForResale = int(tonOnly
+					? std::max(gift.resaleNanoTon / (kNanosInOne / 100), int64(1))
+					: std::max(gift.resaleStars, int64(0))),
+				.number = gift.number,
+				.onlyAcceptTon = tonOnly,
+				.model = model,
+				.pattern = pattern,
+				.backdrop = backdrop,
+				.value = std::move(value),
+			}),
+			.document = model.document,
+			.limitedLeft = total - issued,
+			.limitedCount = total,
+		},
+		.date = gift.date,
+	};
+}
+
+void RequestCatalog(
+		not_null<Main::Session*> session,
+		Fn<void(std::vector<Data::StarGift>)> done,
+		Fn<void(QString)> fail) {
+	auto &cache = CacheFor(session);
+	if (cache.catalog) {
+		done(*cache.catalog);
+		return;
+	}
+	cache.catalogWaiters.push_back({ std::move(done), std::move(fail) });
+	if (cache.catalogWaiters.size() > 1) {
+		return;
+	}
+	session->api().request(MTPpayments_GetStarGifts(
+		MTP_int(0)
+	)).done([=](const MTPpayments_StarGifts &result) {
+		auto gifts = std::vector<Data::StarGift>();
+		result.match([&](const MTPDpayments_starGifts &data) {
+			session->data().processUsers(data.vusers());
+			session->data().processChats(data.vchats());
+			for (const auto &gift : data.vgifts().v) {
+				if (auto parsed = Api::FromTL(session, gift)) {
+					gifts.push_back(std::move(*parsed));
+				}
+			}
+		}, [](const MTPDpayments_starGiftsNotModified &) {
+		});
+		auto &cache = CacheFor(session);
+		cache.catalog = std::move(gifts);
+		for (const auto &waiter : base::take(cache.catalogWaiters)) {
+			waiter.done(*cache.catalog);
+		}
+	}).fail([=](const MTP::Error &error) {
+		for (const auto &waiter : base::take(
+				CacheFor(session).catalogWaiters)) {
+			waiter.fail(error.type());
+		}
+	}).send();
+}
+
+void RequestAttributes(
+		not_null<Main::Session*> session,
+		uint64 giftId,
+		Fn<void(Data::UniqueGiftAttributes)> done,
+		Fn<void(QString)> fail) {
+	auto &cache = CacheFor(session);
+	if (const auto i = cache.attributes.find(giftId)
+		; i != end(cache.attributes)) {
+		done(i->second);
+		return;
+	}
+	auto &waiters = cache.attributeWaiters[giftId];
+	waiters.push_back({ std::move(done), std::move(fail) });
+	if (waiters.size() > 1) {
+		return;
+	}
+	session->api().request(MTPpayments_GetStarGiftUpgradeAttributes(
+		MTP_long(giftId)
+	)).done([=](const MTPpayments_StarGiftUpgradeAttributes &result) {
+		auto attributes = Data::UniqueGiftAttributes();
+		for (const auto &attribute : result.data().vattributes().v) {
+			attribute.match([&](const MTPDstarGiftAttributeModel &data) {
+				attributes.models.push_back(Api::FromTL(session, data));
+			}, [&](const MTPDstarGiftAttributePattern &data) {
+				attributes.patterns.push_back(Api::FromTL(session, data));
+			}, [&](const MTPDstarGiftAttributeBackdrop &data) {
+				attributes.backdrops.push_back(Api::FromTL(data));
+			}, [](const auto &) {
+			});
+		}
+		auto &cache = CacheFor(session);
+		// A copy, a callback may insert into the map and move its storage.
+		const auto stored = cache.attributes[giftId] = std::move(attributes);
+		const auto list = base::take(cache.attributeWaiters[giftId]);
+		cache.attributeWaiters.remove(giftId);
+		for (const auto &waiter : list) {
+			waiter.done(stored);
+		}
+	}).fail([=](const MTP::Error &error) {
+		auto &cache = CacheFor(session);
+		const auto list = base::take(cache.attributeWaiters[giftId]);
+		cache.attributeWaiters.remove(giftId);
+		for (const auto &waiter : list) {
+			waiter.fail(error.type());
+		}
+	}).send();
+}
+
+void ResolveGifts(
+		not_null<PeerData*> peer,
+		Fn<void(std::vector<Data::SavedStarGift>)> done) {
+	const auto session = &peer->session();
+	auto all = LoadGifts();
+	auto gifts = std::vector<std::pair<int, LocalGift>>();
+	for (auto i = 0; i != int(all.size()); ++i) {
+		if (BelongsTo(all[i], peer.get())) {
+			gifts.emplace_back(i, std::move(all[i]));
+		}
+	}
+	if (gifts.empty()) {
+		done({});
+		return;
+	}
+	RequestCatalog(session, [=](std::vector<Data::StarGift> catalog) {
+		struct State {
+			std::vector<Data::StarGift> catalog;
+			base::flat_map<uint64, Data::UniqueGiftAttributes> attributes;
+			int pending = 0;
+		};
+		const auto state = std::make_shared<State>();
+		state->catalog = std::move(catalog);
+
+		auto ids = base::flat_set<uint64>();
+		for (const auto &[index, gift] : gifts) {
+			ids.emplace(gift.giftId);
+		}
+		state->pending = int(ids.size());
+
+		const auto finish = [=] {
+			if (--state->pending > 0) {
+				return;
+			}
+			auto result = std::vector<Data::SavedStarGift>();
+			for (const auto &[index, gift] : gifts) {
+				const auto base = ranges::find(
+					state->catalog,
+					gift.giftId,
+					&Data::StarGift::id);
+				const auto found = state->attributes.find(gift.giftId);
+				if (base == end(state->catalog)
+					|| found == end(state->attributes)) {
+					continue;
+				}
+				const auto &list = found->second;
+				const auto model = FindByName(list.models, gift.modelName);
+				const auto pattern = FindByName(
+					list.patterns,
+					gift.patternName);
+				const auto backdrop = FindByName(
+					list.backdrops,
+					gift.backdropName);
+				if (model && pattern && backdrop) {
+					result.push_back(BuildSavedGift(
+						session,
+						*base,
+						*model,
+						*pattern,
+						*backdrop,
+						gift,
+						index));
+				}
+			}
+			done(std::move(result));
+		};
+		for (const auto id : ids) {
+			RequestAttributes(session, id, [=](
+					Data::UniqueGiftAttributes attributes) {
+				state->attributes.emplace(id, std::move(attributes));
+				finish();
+			}, [=](const QString &) {
+				finish();
+			});
+		}
+	}, [=](const QString &) {
+		done({});
+	});
+}
+
+void PreloadGifts(not_null<PeerData*> peer) {
+	ResolveGifts(peer, [](std::vector<Data::SavedStarGift>) {});
+}
+
+std::vector<LocalUsername> LoadUsernames() {
+	auto result = std::vector<LocalUsername>();
+	for (const auto &value : ReadArray(
+			AyuSettings::getInstance().localUsernames())) {
+		const auto object = value.toObject();
+		const auto username = object.value(u"username"_q).toString();
+		if (username.isEmpty()) {
+			continue;
+		}
+		result.push_back({
+			.username = username,
+			.nanoTon = ReadInt64(object, u"ton"_q),
+			.usdCents = ReadInt64(object, u"usd"_q),
+			.date = TimeId(object.value(u"date"_q).toInt()),
+			.ownerName = object.value(u"ownerName"_q).toString(),
+			.ownerUrl = object.value(u"ownerUrl"_q).toString(),
+		});
+	}
+	return result;
+}
+
+QString NormalizeOwnerUrl(QString text) {
+	text = text.trimmed();
+	if (text.isEmpty()) {
+		return QString();
+	} else if (text.startsWith('@')) {
+		return u"https://t.me/"_q + text.mid(1);
+	} else if (text.startsWith(u"https://"_q)
+		|| text.startsWith(u"http://"_q)) {
+		return text;
+	}
+	return u"https://"_q + text;
+}
+
+void SaveUsernames(const std::vector<LocalUsername> &usernames) {
+	auto array = QJsonArray();
+	for (const auto &entry : usernames) {
+		auto object = QJsonObject();
+		object.insert(u"username"_q, entry.username);
+		object.insert(u"ton"_q, QString::number(entry.nanoTon));
+		object.insert(u"usd"_q, QString::number(entry.usdCents));
+		object.insert(u"date"_q, int(entry.date));
+		object.insert(u"ownerName"_q, entry.ownerName);
+		object.insert(u"ownerUrl"_q, entry.ownerUrl);
+		array.push_back(object);
+	}
+	AyuSettings::getInstance().setLocalUsernames(WriteArray(array));
+}
+
+std::optional<LocalUsername> FindUsername(const QString &username) {
+	const auto clean = username.startsWith('@')
+		? username.mid(1)
+		: username;
+	for (const auto &entry : LoadUsernames()) {
+		if (!entry.username.compare(clean, Qt::CaseInsensitive)) {
+			return entry;
+		}
+	}
+	return std::nullopt;
+}
+
+int64 ParseNanoTon(QString text) {
+	text = text.trimmed().replace(',', '.');
+	if (text.isEmpty()) {
+		return 0;
+	}
+	const auto dot = text.indexOf('.');
+	const auto wholePart = (dot < 0) ? text : text.mid(0, dot);
+	auto fractionPart = (dot < 0) ? QString() : text.mid(dot + 1);
+	auto ok = true;
+	const auto whole = wholePart.isEmpty() ? 0LL : wholePart.toLongLong(&ok);
+	if (!ok || whole < 0 || whole > 1'000'000'000LL) {
+		return 0;
+	}
+	fractionPart = fractionPart.left(kNanoDigits);
+	while (fractionPart.size() < kNanoDigits) {
+		fractionPart.append('0');
+	}
+	const auto fraction = fractionPart.toLongLong(&ok);
+	if (!ok || fraction < 0) {
+		return 0;
+	}
+	return whole * kNanosInOne + fraction;
+}
+
+QString FormatNanoTon(int64 nanoTon) {
+	if (nanoTon <= 0) {
+		return QString();
+	}
+	auto result = QString::number(nanoTon / kNanosInOne);
+	if (const auto fraction = nanoTon % kNanosInOne) {
+		auto digits = QString::number(fraction).rightJustified(
+			kNanoDigits,
+			'0');
+		while (digits.endsWith('0')) {
+			digits.chop(1);
+		}
+		result += '.' + digits;
+	}
+	return result;
+}
+
+CreditsAmount LocalStarsAmount() {
+	return CreditsAmount(
+		std::max(AyuSettings::getInstance().localStars(), int64(0)));
+}
+
+CreditsAmount LocalTonAmount() {
+	const auto nano = ParseNanoTon(AyuSettings::getInstance().localTon());
+	return CreditsAmount(
+		nano / kNanosInOne,
+		nano % kNanosInOne,
+		CreditsType::Ton);
+}
+
+void RefreshBalances() {
+	for (const auto &entry : Core::App().domain().accounts()) {
+		if (entry.account->sessionExists()) {
+			auto &credits = entry.account->session().credits();
+			credits.load(true);
+			credits.tonLoad(true);
+		}
+	}
+}
+
+} // namespace AyuCosmetics
