+#include "window/window_session_controller.h"
+
+namespace AyuCosmetics {
+namespace {
+
+constexpr auto kMaxNumber = 9999999;
+
+struct State {
+	std::vector<Data::StarGift> catalog;
+	Data::UniqueGiftAttributes attributes;
+	int gift = -1;
+	int model = -1;
+	int backdrop = -1;
+	int pattern = -1;
+	rpl::variable<QString> giftLabel;
+	rpl::variable<QString> modelLabel;
+	rpl::variable<QString> backdropLabel;
+	rpl::variable<QString> patternLabel;
+};
+
+void ChooseOptionBox(
+		not_null<Ui::GenericBox*> box,
+		QString title,
+		std::vector<QString> labels,
+		Fn<void(int)> chosen) {
+	box->setTitle(rpl::single(title));
+	for (auto i = 0; i != int(labels.size()); ++i) {
+		const auto button = Settings::AddButtonWithIcon(
+			box->verticalLayout(),
+			rpl::single(labels[i]),
+			st::settingsButtonNoIcon);
+		button->setClickedCallback([=] {
+			chosen(i);
+			box->closeBox();
+		});
+	}
+	box->addButton(tr::lng_cancel(), [=] {
+		box->closeBox();
+	});
+}
+
+[[nodiscard]] QString GiftTitle(const Data::StarGift &gift) {
+	if (!gift.resellTitle.isEmpty()) {
+		return gift.resellTitle;
+	}
+	const auto sticker = gift.document->sticker();
+	return sticker ? sticker->alt : QString::number(gift.id);
+}
+
+template <typename Attribute>
+[[nodiscard]] std::vector<QString> AttributeLabels(
+		const std::vector<Attribute> &list) {
+	auto result = std::vector<QString>();
+	result.reserve(list.size());
+	for (const auto &attribute : list) {
+		result.push_back(attribute.name
+			+ u" · "_q
+			+ Data::UniqueGiftAttributeText(attribute));
+	}
+	return result;
+}
+
+void NotifyGiftsChanged(not_null<Window::SessionController*> controller) {
+	const auto session = &controller->session();
+	session->changes().peerUpdated(
+		session->user(),
+		Data::PeerUpdate::Flag::PeerGifts);
+}
+
+} // namespace
+
+void LocalNftConstructorBox(
+		not_null<Ui::GenericBox*> box,
+		not_null<Window::SessionController*> controller) {
+	const auto session = &controller->session();
+	const auto state = box->lifetime().make_state<State>();
+	const auto container = box->verticalLayout();
+	box->setTitle(tr::ayu_LocalNftConstructor());
+
+	const auto loading = tr::ayu_LocalNftLoading(tr::now);
+	state->giftLabel = loading;
+	const auto addRow = [=](
+			rpl::producer<QString> title,
+			rpl::producer<QString> value) {
+		return Settings::AddButtonWithLabel(
+			container,
+			std::move(title),
+			std::move(value),
+			st::settingsButtonNoIcon);
+	};
+	const auto giftButton = addRow(
+		tr::ayu_LocalNftGift(),
+		state->giftLabel.value());
+	const auto modelButton = addRow(
+		tr::ayu_LocalNftModel(),
+		state->modelLabel.value());
+	const auto backdropButton = addRow(
+		tr::ayu_LocalNftBackdrop(),
+		state->backdropLabel.value());
+	const auto patternButton = addRow(
+		tr::ayu_LocalNftPattern(),
+		state->patternLabel.value());
+
+	const auto title = box->addRow(object_ptr<Ui::InputField>(
+		container,
+		st::defaultInputField,
+		tr::ayu_LocalNftTitle(),
+		QString()));
+	const auto number = box->addRow(object_ptr<Ui::InputField>(
+		container,
+		st::defaultInputField,
+		tr::ayu_LocalNftNumber(),
+		u"1"_q));
+	const auto owner = box->addRow(object_ptr<Ui::InputField>(
+		container,
+		st::defaultInputField,
+		tr::ayu_LocalNftOwner(),
+		session->user()->name()));
+
+	const auto selectModel = [=](int index) {
+		state->model = index;
+		state->modelLabel = state->attributes.models[index].name;
+	};
+	const auto selectBackdrop = [=](int index) {
+		state->backdrop = index;
+		state->backdropLabel = state->attributes.backdrops[index].name;
+	};
+	const auto selectPattern = [=](int index) {
+		state->pattern = index;
+		state->patternLabel = state->attributes.patterns[index].name;
+	};
+	const auto selectGift = [=](int index) {
+		const auto &gift = state->catalog[index];
+		state->gift = index;
+		state->model = state->backdrop = state->pattern = -1;
+		state->attributes = {};
+		state->giftLabel = GiftTitle(gift);
+		state->modelLabel = loading;
+		state->backdropLabel = loading;
+		state->patternLabel = loading;
+		title->setText(GiftTitle(gift));
+		RequestAttributes(session, gift.id, crl::guard(box, [=](
+				Data::UniqueGiftAttributes attributes) {
+			if (state->gift != index) {
+				return;
+			}
+			state->attributes = std::move(attributes);
+			const auto &list = state->attributes;
+			if (list.models.empty()
+				|| list.backdrops.empty()
+				|| list.patterns.empty()) {
+				controller->showToast(tr::ayu_LocalNftNoAttributes(tr::now));
+				return;
+			}
+			selectModel(0);
+			selectBackdrop(0);
+			selectPattern(0);
+		}), crl::guard(box, [=](const QString &error) {
+			controller->showToast(error);
+		}));
+	};
+
+	RequestCatalog(session, crl::guard(box, [=](
+			std::vector<Data::StarGift> catalog) {
+		catalog.erase(ranges::remove_if(catalog, [](
+				const Data::StarGift &gift) {
+			return !gift.upgradable && !gift.upgradeVariants;
+		}), end(catalog));
+		state->catalog = std::move(catalog);
+		if (state->catalog.empty()) {
+			state->giftLabel = QString();
+			controller->showToast(tr::ayu_LocalNftNoAttributes(tr::now));
+			return;
+		}
+		selectGift(0);
+	}), crl::guard(box, [=](const QString &error) {
+		controller->showToast(error);
+	}));
+
+	const auto choose = [=](
+			QString boxTitle,
+			std::vector<QString> labels,
+			Fn<void(int)> chosen) {
+		if (labels.empty()) {
+			return;
+		}
+		controller->show(Box(
+			ChooseOptionBox,
+			std::move(boxTitle),
+			std::move(labels),
+			std::move(chosen)));
+	};
+	giftButton->setClickedCallback([=] {
+		auto labels = std::vector<QString>();
+		labels.reserve(state->catalog.size());
+		for (const auto &gift : state->catalog) {
+			labels.push_back(GiftTitle(gift));
+		}
+		choose(
+			tr::ayu_LocalNftGift(tr::now),
+			std::move(labels),
+			selectGift);
+	});
+	modelButton->setClickedCallback([=] {
+		choose(
+			tr::ayu_LocalNftModel(tr::now),
+			AttributeLabels(state->attributes.models),
+			selectModel);
+	});
+	backdropButton->setClickedCallback([=] {
+		choose(
+			tr::ayu_LocalNftBackdrop(tr::now),
+			AttributeLabels(state->attributes.backdrops),
+			selectBackdrop);
+	});
+	patternButton->setClickedCallback([=] {
+		choose(
+			tr::ayu_LocalNftPattern(tr::now),
+			AttributeLabels(state->attributes.patterns),
+			selectPattern);
+	});
+
+	const auto ready = [=] {
+		if (state->gift >= 0
+			&& state->model >= 0
+			&& state->backdrop >= 0
+			&& state->pattern >= 0) {
+			return true;
+		}
+		controller->showToast(tr::ayu_LocalNftSelectAll(tr::now));
+		return false;
+	};
+	const auto current = [=] {
+		const auto &list = state->attributes;
+		return LocalGift{
+			.giftId = state->catalog[state->gift].id,
+			.title = title->getLastText().trimmed(),
+			.modelName = list.models[state->model].name,
+			.backdropName = list.backdrops[state->backdrop].name,
+			.patternName = list.patterns[state->pattern].name,
+			.ownerName = owner->getLastText().trimmed(),
+			.number = std::clamp(
+				number->getLastText().trimmed().toInt(),
+				1,
+				kMaxNumber),
+			.date = base::unixtime::now(),
+		};
+	};
+	box->addLeftButton(tr::ayu_LocalNftPreview(), [=] {
+		if (!ready()) {
+			return;
+		}
+		const auto &list = state->attributes;
+		Settings::ShowSavedStarGiftBox(
+			controller,
+			session->user(),
+			BuildSavedGift(
+				state->catalog[state->gift],
+				list.models[state->model],
+				list.patterns[state->pattern],
+				list.backdrops[state->backdrop],
+				current(),
+				GiftsCount()));
+	});
+	box->addButton(tr::lng_settings_save(), [=] {
+		if (!ready()) {
+			return;
+		}
+		auto gifts = LoadGifts();
+		gifts.push_back(current());
+		SaveGifts(gifts);
+		NotifyGiftsChanged(controller);
+		controller->showToast(tr::ayu_LocalNftSaved(tr::now));
+		box->closeBox();
+	});
+	box->addButton(tr::lng_cancel(), [=] {
+		box->closeBox();
+	});
+}
+
+void LocalNftListBox(
+		not_null<Ui::GenericBox*> box,
+		not_null<Window::SessionController*> controller) {
+	box->setTitle(tr::ayu_LocalNftList());
+	const auto gifts = LoadGifts();
+	for (auto i = 0; i != int(gifts.size()); ++i) {
+		const auto button = Settings::AddButtonWithIcon(
+			box->verticalLayout(),
+			rpl::single(gifts[i].title
+				+ u" #"_q
+				+ QString::number(gifts[i].number)),
+			st::settingsButtonNoIcon);
+		button->setClickedCallback([=] {
+			controller->show(Ui::MakeConfirmBox({
+				.text = tr::ayu_LocalNftDeleteConfirm(tr::rich),
+				.confirmed = [=](Fn<void()> &&close) {
+					auto now = LoadGifts();
+					if (i < int(now.size())) {
+						now.erase(begin(now) + i);
+						SaveGifts(now);
+						NotifyGiftsChanged(controller);
+					}
+					close();
+					box->closeBox();
+				},
+				.confirmText = tr::lng_box_yes(),
+			}));
+		});
+	}
+	box->addButton(tr::lng_close(), [=] {
+		box->closeBox();
+	});
+}
+
+} // namespace AyuCosmetics
