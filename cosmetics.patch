+template <typename Attribute>
+[[nodiscard]] int FindIndexById(
+		const std::vector<Attribute> &list,
+		const Attribute &value) {
+	for (auto i = 0; i != int(list.size()); ++i) {
+		if (Data::IdFor(list[i]) == Data::IdFor(value)) {
+			return i;
+		}
+	}
+	return -1;
+}
