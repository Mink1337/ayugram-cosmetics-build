+// Copyright @Radolyn, 2026
+#pragma once
+
+#include "data/data_star_gift.h"
+
+namespace Main {
+class Session;
+} // namespace Main
+
+namespace AyuCosmetics {
+
+struct LocalGift {
+	uint64 giftId = 0;
+	QString title;
+	QString modelName;
+	QString backdropName;
+	QString patternName;
+	QString ownerName;
+	int number = 1;
+	TimeId date = 0;
+};
+
+[[nodiscard]] bool IsLocalBadgePeer(int64 bareId);
+[[nodiscard]] bool IsLocalGiftId(uint64 id);
+
+[[nodiscard]] std::vector<LocalGift> LoadGifts();
+void SaveGifts(const std::vector<LocalGift> &gifts);
+[[nodiscard]] int GiftsCount();
+
+[[nodiscard]] Data::SavedStarGift BuildSavedGift(
+	const Data::StarGift &base,
+	const Data::UniqueGiftModel &model,
+	const Data::UniqueGiftPattern &pattern,
+	const Data::UniqueGiftBackdrop &backdrop,
+	const LocalGift &gift,
+	int index);
+
+void RequestCatalog(
+	not_null<Main::Session*> session,
+	Fn<void(std::vector<Data::StarGift>)> done,
+	Fn<void(QString)> fail);
+void RequestAttributes(
+	not_null<Main::Session*> session,
+	uint64 giftId,
+	Fn<void(Data::UniqueGiftAttributes)> done,
+	Fn<void(QString)> fail);
+void ResolveGifts(
