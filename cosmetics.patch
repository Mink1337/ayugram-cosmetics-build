+[[nodiscard]] CreditsAmount ResaleAmount(int64 stars, int64 nanoTon) {
+	if (stars > 0) {
+		return CreditsAmount(stars);
+	} else if (nanoTon > 0) {
+		return CreditsAmount(
+			nanoTon / kNanosInOne,
+			nanoTon % kNanosInOne,
+			CreditsType::Ton);
+	}
+	return CreditsAmount();
