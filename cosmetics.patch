+	box->setWidth(st::boxWideWidth);
+
+	const auto gifts = box->addRow(
+		object_ptr<Ui::RpWidget>(box),
+		QMargins(
+			st::giftBoxPadding.left(),
+			st::giftBoxPadding.top(),
+			st::giftBoxPadding.right(),
+			st::giftBoxPadding.bottom()));
+	for (auto i = 0; i != int(catalog.size()); ++i) {
+		state->buttons.push_back(
+			Ui::CreateChild<GiftButton>(gifts, &state->delegate));
+		const auto button = state->buttons.back();
+		button->setDescriptor(GiftTypeStars{
+			.info = catalog[i],
+		}, GiftButton::Mode::Minimal);
+		if (i == selected) {
+			button->toggleSelected(true, {}, anim::type::instant);
+		}
+		button->setClickedCallback([=] {
+			chosen(i);
+			box->closeBox();
+		});
+	}
+
+	gifts->widthValue() | rpl::on_next([=](int width) {
+		const auto singleMin = state->delegate.buttonSize();
+		if (width < singleMin.width()) {
+			return;
+		}
+		const auto count = int(state->buttons.size());
+		const auto skipw = st::giftBoxGiftSkip.x();
+		const auto skiph = st::giftBoxGiftSkip.y();
+		const auto perRow = std::min(
+			(width + skipw) / (singleMin.width() + skipw),
+			std::max(count, 1));
+		if (perRow <= 0) {
+			return;
+		}
+		const auto single = (width - (perRow - 1) * skipw) / perRow;
+		const auto height = singleMin.height();
+		const auto rows = (count + perRow - 1) / perRow;
+		for (auto index = 0; index != count; ++index) {
+			const auto row = index / perRow;
+			const auto column = index % perRow;
+			state->buttons[index]->setGeometry(
+				QRect(
+					column * (single + skipw),
+					row * (height + skiph),
+					single,
+					height),
+				state->delegate.buttonExtend());
+		}
+		gifts->resize(width, std::max(rows * (height + skiph) - skiph, 0));
+	}, gifts->lifetime());
+
+	box->addButton(tr::lng_cancel(), [=] {
+		box->closeBox();
+	});
+}
+
+void ChooseRecipient(
+		not_null<Window::SessionController*> controller,
+		Fn<void(not_null<PeerData*>)> chosen) {
+	const auto boxPointer = std::make_shared<QPointer<PeerListBox>>();
+	auto list = std::make_unique<ChooseRecipientBoxController>(
+		&controller->session(),
+		[=](not_null<Data::Thread*> thread) {
+			chosen(thread->peer());
+			if (const auto box = boxPointer->data()) {
+				box->closeBox();
+			}
+		},
+		[](not_null<Data::Thread*> thread) {
+			const auto user = thread->peer()->asUser();
+			return user && !user->isBot();
+		});
+	auto initBox = [=](not_null<PeerListBox*> box) {
+		*boxPointer = box.get();
+		box->setTitle(tr::ayu_LocalNftChooseRecipient());
+		box->addButton(tr::lng_cancel(), [=] {
+			box->closeBox();
+		});
+	};
+	controller->show(Box<PeerListBox>(std::move(list), std::move(initBox)));
+}
+
+void SellGiftBox(
+		not_null<Ui::GenericBox*> box,
+		not_null<Window::SessionController*> controller,
+		int index) {
+	const auto gifts = LoadGifts();
+	if (index < 0 || index >= int(gifts.size())) {
+		return;
+	}
+	const auto &gift = gifts[index];
+	box->setTitle(rpl::single(u"Продать подарок"_q));
+	const auto stars = AddField(
+		box,
+		tr::ayu_LocalNftPriceStars(),
+		(gift.resaleStars > 0)
+			? QString::number(gift.resaleStars)
+			: QString());
+	const auto ton = AddField(
+		box,
+		tr::ayu_LocalNftPriceTon(),
+		FormatNanoTon(gift.resaleNanoTon));
+	box->addButton(tr::lng_settings_save(), [=] {
+		auto now = LoadGifts();
+		if (index < int(now.size())) {
+			const auto price = ParseStars(stars->getLastText());
+			now[index].resaleStars = price;
+			now[index].resaleNanoTon = price
+				? int64(0)
+				: ParseNanoTon(ton->getLastText());
+			SaveGifts(now);
+			NotifyGiftsChanged(
+				controller,
+				GiftOwnerId(&controller->session(), now[index]));
+		}
+		box->closeBox();
+	});
+	box->addButton(tr::lng_cancel(), [=] {
+		box->closeBox();
+	});
+}
