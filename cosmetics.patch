+void InnerWidget::refreshLocalGifts() {
+	const auto descriptor = _descriptor.current();
+	const auto &filter = descriptor.filter;
+	if (!_peer->isUser()
+		|| descriptor.collectionId
+		|| _addingToCollectionId
+		|| filter.skipUnique
+		|| filter.skipSaved) {
+		return;
+	}
+	AyuCosmetics::ResolveGifts(_peer, crl::guard(this, [=](
+			std::vector<Data::SavedStarGift> gifts) {
+		insertLocalGifts(std::move(gifts));
+	}));
+}
+
+void InnerWidget::insertLocalGifts(std::vector<Data::SavedStarGift> gifts) {
+	if (_descriptor.current().collectionId) {
+		return;
+	}
+	const auto isLocal = [](const Entry &entry) {
+		return AyuCosmetics::IsLocalGiftId(entry.gift.info.id);
+	};
+	const auto was = int(ranges::count_if(*_list, isLocal));
+	_list->erase(ranges::remove_if(*_list, isLocal), end(*_list));
+	// Kept after the pinned gifts, markPinned relies on them being first.
+	auto position = ranges::find_if(*_list, [](const Entry &entry) {
+		return !entry.gift.pinned;
+	});
+	for (auto &gift : gifts) {
+		auto descriptor = DescriptorForGift(_peer, gift);
+		position = _list->insert(position, Entry{
+			.gift = std::move(gift),
+			.descriptor = std::move(descriptor),
+		}) + 1;
+	}
+	_entries->total = _entries->allLoaded
+		? int(_entries->list.size())
+		: std::max(
+			_entries->total - was + int(gifts.size()),
+			int(_entries->list.size()));
+	refreshButtons();
+	refreshAbout();
 }
 
